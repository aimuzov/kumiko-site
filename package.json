{
	"name": "kumiko-site",
	"type": "module",
	"version": "1.6.3",
	"private": true,
	"license": "MIT",
	"engines": {
		"node": "26.11.1"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"check": "astro check && svelte-check",
		"test": "node --test 'src/**/*.test.ts'",
		"test:e2e": "playwright test",
		"astro": "astro",
		"format": "oxlint --fix && prettier --write .",
		"format:check": "prettier --check .",
		"lint:css": "stylelint \"src/**/*.{css,astro,svelte}\"",
		"lint:js": "oxlint --deny-warnings",
		"lint:fix": "oxlint --fix"
	},
	"dependencies": {
		"@astrojs/sitemap": "3.7.6",
		"@astrojs/svelte": "9.1.6",
		"@fontsource-variable/manrope": "5.3.0",
		"@lucide/svelte": "1.61.0",
		"astro": "7.4.13",
		"svelte": "5.58.0"
	},
	"devDependencies": {
		"@aimuzov/infra-site-kit": "github:aimuzov/infra-site-kit#661bf5760d9fda3c0ba6bd35ddb4cbb4537aa929",
		"@astrojs/check": "0.9.12",
		"@playwright/test": "1.64.0",
		"@types/node": "26.6.6",
		"lucide-static": "1.61.0",
		"oxlint": "1.93.0",
		"prettier": "3.10.1",
		"stylelint": "17.16.0",
		"svelte-check": "4.7.8",
		"typescript": "6.0.3"
	},
	"imports": {
		"#frontend/*": "./src/frontend/*"
	}
}
