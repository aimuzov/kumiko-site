---
import LangSwitch from '@aimuzov/infra-site-kit/ui/lang-switch.svelte'
import type { Locale } from '@aimuzov/infra-site-kit/i18n.js'
import { localizePath } from '@aimuzov/infra-site-kit/i18n.js'
import { History } from 'lucide-static'

import ThemeButton from '#frontend/components/theme-button.svelte'
import { t } from '#frontend/lib/i18n.ts'

type Props = { locale: Locale }

const { locale } = Astro.props
const changelog = localizePath('/changelog/', locale)
const here = Astro.url.pathname.replace(/\/?$/, '/') === changelog
---

<!-- Ряд в правом верхнем углу: история версий, язык и тема. На всех страницах одно место,
     поэтому при переходах он не прыгает -->
<div class="corner">
	<a
		class="corner__link"
		href={changelog}
		aria-label={t(locale, 'changelog.link')}
		title={t(locale, 'changelog.link')}
		aria-current={here ? 'page' : undefined}
		set:html={History}
	/>
	<LangSwitch {locale} path={Astro.url.pathname} client:load />
	<ThemeButton label={t(locale, 'theme.toggle')} client:load />
</div>

<style>
	.corner {
		position: fixed;
		z-index: 30;
		top: var(--corner-top);
		right: var(--corner-right);
		display: flex;
		gap: 4px;
		align-items: center;
		padding: 2px;
		border-radius: 999px;
		background: color-mix(in srgb, var(--bg) 72%, transparent);
		backdrop-filter: blur(12px);
	}

	.corner__link {
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		color: var(--fg);
		opacity: 0.6;
		transition: opacity 0.2s ease;

		&:hover,
		&:focus-visible,
		&[aria-current='page'] {
			opacity: 1;
		}

		&:focus-visible {
			outline: 2px solid var(--accent);
			outline-offset: 2px;
		}

		/* stylelint-disable-next-line selector-max-type -- SVG из lucide-static приходит без класса */
		& :global(svg) {
			width: 20px;
			height: 20px;
		}
	}
</style>
