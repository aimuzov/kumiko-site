---
import type { Locale } from '@aimuzov/infra-site-kit/i18n.js'
import { Download, LayoutDashboard } from 'lucide-static'

import BigTitle from '#frontend/components/big-title.astro'
import BrewCommand from '#frontend/components/brew-command.svelte'
import { t } from '#frontend/lib/i18n.ts'

type Props = {
	locale: Locale
	/** Прямая ссылка на архив последнего релиза и его версия. */
	download: string
	version: string
}

const { locale, download, version } = Astro.props

/** Окна, что лежат вразброс. Место в хаосе и в плитке -- в стилях по классу окна. */
const windows = ['code', 'music', 'web', 'chat', 'term', 'notes']
---

<!-- Финал: окна лежат вразброс, под углом и внахлёст, а окно со скачиванием -- посередине.
     Когда раздел доезжает до рубежа, lib/final.ts ставит final--tiled, и окна по очереди плавно
     расходятся по плитке, а окно со скачиванием встаёт в центр во всю высоту. Без скрипта и при
     просьбе о меньшем движении окна сразу стоят плиткой -->
<section class="final" aria-labelledby="final-title" data-final>
	<div class="container">
		<BigTitle id="final-title" icon={LayoutDashboard} side="right" text={t(locale, 'final.title')} />
		<div class="final__screen" data-screen>
			{windows.map((kind) => (
				<div class={`final__slot final__slot--${kind}`} aria-hidden="true">
					<div class={`final__win final__win--${kind}`}>
						<span class="final__chrome" />
						<span class="final__body" />
					</div>
				</div>
			))}
			<div class="final__slot final__slot--cta">
				<div class="final__win final__win--cta">
					<span class="final__chrome" aria-hidden="true"></span>
					<div class="final__cta">
						<p class="final__done">{t(locale, 'final.done')}</p>
						<a class="final__download" href={download}>
							<span set:html={Download} aria-hidden="true" />
							{t(locale, 'hero.download', { version })}
						</a>
						<span class="final__brew">
							<BrewCommand {locale} client:visible />
						</span>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	import { initFinal } from '#frontend/lib/final.ts'

	for (const section of document.querySelectorAll<HTMLElement>('[data-final]')) initFinal(section)
</script>

<style>
	/* Над окнами -- огромный заголовок из big-title.astro, как у остальных разделов */
	.final {
		isolation: isolate;
		position: relative;
		overflow-x: clip;
		padding-block: var(--section-top) calc(var(--section-y) * 1.5);
	}

	.final__screen {
		position: relative;
		height: min(78vh, 720px);

		@media (--below-sm) {
			height: 86vh;
		}
	}

	/* --k -- насколько окно уже встало. Число зарегистрировано, поэтому переход тянет его
	   плавно, а вместе с ним место, размер и наклон окна */
	@property --k {
		syntax: '<number>';
		inherits: false;
		initial-value: 1;
	}

	/* Окно стоит между местом в хаосе (x0, y0, w0, h0, r0) и местом в плитке (x1, y1, w1, h1).
	   Без скрипта --k равно 1, и окна сразу стоят плиткой */
	.final__slot {
		position: absolute;
		top: calc(var(--y0) + (var(--y1) - var(--y0)) * var(--k));
		left: calc(var(--x0) + (var(--x1) - var(--x0)) * var(--k));
		transform: rotate(calc(var(--r0) * (1 - var(--k))));
		width: calc(var(--w0) + (var(--w1) - var(--w0)) * var(--k));
		height: calc(var(--h0) + (var(--h1) - var(--h0)) * var(--k));
		padding: 5px;

		/* Окна расходятся по очереди с перелётом, окно со скачиванием -- последним */
		.final--armed & {
			--k: 0;

			transition: --k 1.1s cubic-bezier(0.34, 1.32, 0.64, 1) var(--delay, 0s);
		}

		.final--tiled & {
			--k: 1;
		}
	}

	.final__slot--code {
		--x0: 2%;
		--y0: 4%;
		--w0: 32%;
		--h0: 42%;
		--r0: -9deg;
		--x1: 0%;
		--y1: 0%;
		--w1: 28%;
		--h1: 40%;
		--delay: 0s;
	}

	.final__slot--music {
		--x0: 4%;
		--y0: 60%;
		--w0: 28%;
		--h0: 30%;
		--r0: 13deg;
		--x1: 0%;
		--y1: 40%;
		--w1: 28%;
		--h1: 25%;
		--delay: 0.08s;
	}

	.final__slot--web {
		--x0: 66%;
		--y0: 2%;
		--w0: 32%;
		--h0: 34%;
		--r0: 7deg;
		--x1: 0%;
		--y1: 65%;
		--w1: 28%;
		--h1: 35%;
		--delay: 0.16s;
	}

	.final__slot--chat {
		--x0: 30%;
		--y0: 58%;
		--w0: 26%;
		--h0: 34%;
		--r0: -11deg;
		--x1: 72%;
		--y1: 0%;
		--w1: 28%;
		--h1: 34%;
		--delay: 0.24s;
	}

	.final__slot--term {
		--x0: 68%;
		--y0: 52%;
		--w0: 28%;
		--h0: 36%;
		--r0: -13deg;
		--x1: 72%;
		--y1: 34%;
		--w1: 28%;
		--h1: 33%;
		--delay: 0.32s;
	}

	.final__slot--notes {
		--x0: 40%;
		--y0: 6%;
		--w0: 22%;
		--h0: 32%;
		--r0: -4deg;
		--x1: 72%;
		--y1: 67%;
		--w1: 28%;
		--h1: 33%;
		--delay: 0.4s;
	}

	.final__slot--cta {
		--x0: 33%;
		--y0: 28%;
		--w0: 34%;
		--h0: 44%;
		--r0: -5deg;
		--x1: 28%;
		--y1: 0%;
		--w1: 44%;
		--h1: 100%;
		--delay: 0.55s;

		z-index: 2;
	}

	/* На телефоне плитка в столбик: окно со скачиванием -- широкой полосой посередине. Селектор
	   сильнее основного: минификатор ставит медиазапрос раньше, и иначе основной перебил бы его */
	@media (--below-sm) {
		.final__screen .final__slot--code {
			--x1: 0%;
			--y1: 0%;
			--w1: 50%;
			--h1: 20%;
		}

		.final__screen .final__slot--music {
			--x1: 50%;
			--y1: 0%;
			--w1: 50%;
			--h1: 20%;
		}

		.final__screen .final__slot--cta {
			--x0: 10%;
			--y0: 30%;
			--w0: 80%;
			--h0: 36%;
			--x1: 0%;
			--y1: 20%;
			--w1: 100%;
			--h1: 44%;
		}

		.final__screen .final__slot--web {
			--x1: 0%;
			--y1: 64%;
			--w1: 34%;
			--h1: 36%;
		}

		.final__screen .final__slot--chat {
			--x1: 34%;
			--y1: 64%;
			--w1: 33%;
			--h1: 36%;
		}

		.final__screen .final__slot--term,
		.final__screen .final__slot--notes {
			--x1: 67%;
			--w1: 33%;
			--h1: 18%;
		}

		.final__screen .final__slot--term {
			--y1: 64%;
		}

		.final__screen .final__slot--notes {
			--y1: 82%;
		}
	}

	.final__win {
		overflow: hidden;
		display: flex;
		flex-direction: column;
		height: 100%;
		border-radius: 12px;
		background: #1e1f24;
		box-shadow:
			0 0 0 1px rgb(255 255 255 / 6%),
			0 18px 40px rgb(0 0 0 / 30%);
		transition: box-shadow 0.4s ease;

		&--web {
			background: #f4efe6;
		}

		&--notes {
			background: #fdf3c4;
		}

		&--term {
			background: #111214;
		}
	}

	.final__chrome {
		flex: none;
		height: 22px;
		background:
			radial-gradient(circle at 14px 50%, #ff5f57 4px, transparent 4.5px),
			radial-gradient(circle at 28px 50%, #febc2e 4px, transparent 4.5px),
			radial-gradient(circle at 42px 50%, #28c840 4px, transparent 4.5px), rgb(255 255 255 / 6%);

		.final__win--web &,
		.final__win--notes &,
		.final__win--cta & {
			background-color: rgb(0 0 0 / 6%);
		}
	}

	.final__body {
		flex: 1;
		margin: 7%;

		.final__win--code & {
			background:
				repeating-linear-gradient(#0000 0 2px, #c792ea88 2px 7px, #0000 7px 48px) 0 0 / 40% 100% no-repeat,
				repeating-linear-gradient(#0000 0 14px, #82aaff77 14px 19px, #0000 19px 48px) 10% 0 / 66% 100% no-repeat,
				repeating-linear-gradient(#0000 0 26px, #c3e88d77 26px 31px, #0000 31px 48px) 20% 0 / 50% 100% no-repeat,
				repeating-linear-gradient(#0000 0 38px, #f78c6c77 38px 43px, #0000 43px 48px) 0 0 / 28% 100% no-repeat;
		}

		.final__win--web & {
			background:
				linear-gradient(#c08a5c, #9a5f30) 0 0 / 100% 40% no-repeat,
				repeating-linear-gradient(#0000 0 10px, #2b1d1322 10px 14px) 0 100% / 100% 48% no-repeat;
		}

		.final__win--chat & {
			background:
				linear-gradient(#3e8ef7, #3e8ef7) 100% 10% / 48% 16% no-repeat,
				linear-gradient(#ffffff26, #ffffff26) 0 45% / 58% 16% no-repeat,
				linear-gradient(#3e8ef7, #3e8ef7) 100% 80% / 36% 16% no-repeat;
		}

		.final__win--term & {
			background: repeating-linear-gradient(#0000 0 8px, #5af78e66 8px 11px, #0000 11px 18px) 0 0 / 64% 100%
				no-repeat;
		}

		.final__win--notes & {
			background: repeating-linear-gradient(#0000 0 12px, #8a6d1f44 12px 14px) 0 0 / 100% 100% no-repeat;
		}

		.final__win--music & {
			border-radius: 8px;
			background:
				linear-gradient(90deg, #ff2d55 0 38%, #0000 38%) 0 100% / 100% 6px no-repeat,
				linear-gradient(135deg, #af52de, #ff9500) 0 0 / 28% 70% no-repeat,
				repeating-linear-gradient(#0000 0 12px, #ffffff22 12px 16px) 100% 0 / 64% 70% no-repeat;
		}
	}

	/* Окно со скачиванием медное, в цвет иконки kumiko, поэтому выделяется среди остальных.
	   Кнопка скачивания в нём переворачивает цвета: светлая на меди */
	.final__win--cta {
		--accent: #f3e2c3;
		--on-accent: #4f2f1b;

		color: #fff4e2;
		background: linear-gradient(160deg, #a2693c, #5a3420);
		box-shadow:
			0 0 0 1px rgb(255 255 255 / 10%),
			0 24px 60px rgb(80 45 20 / 45%);
		transition: box-shadow 0.5s ease 1.2s;

		& .final__chrome {
			background-color: rgb(0 0 0 / 14%);
		}

		/* Всё встало: на нём рамка фокуса kumiko и мягкое свечение */
		.final--tiled & {
			box-shadow:
				0 0 0 3px #8aadf4,
				0 0 50px color-mix(in srgb, #8aadf4 45%, transparent),
				0 24px 60px rgb(80 45 20 / 45%);
		}
	}

	.final__download {
		display: inline-flex;
		gap: 8px;
		align-items: center;
		padding: 14px 26px;
		border-radius: 999px;
		font-size: 1.0625rem;
		font-weight: 700;
		color: var(--on-accent);
		text-decoration: none;
		background: var(--accent);
		box-shadow: 0 12px 32px rgb(0 0 0 / 25%);
		transition:
			transform 0.2s ease,
			filter 0.2s ease;

		&:hover {
			transform: translateY(-2px);
			filter: brightness(1.05);
		}

		&:focus-visible {
			outline: 2px solid var(--accent);
			outline-offset: 3px;
		}

		/* stylelint-disable-next-line selector-max-type -- SVG из lucide-static приходит без класса */
		& :global(svg) {
			width: 20px;
			height: 20px;
		}
	}

	/* Содержимое масштабируется под само окно, оно же меняет размер */
	.final__cta {
		container-type: size;
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 16px;
		align-items: center;
		justify-content: center;
		padding: 16px;
		text-align: center;
	}

	.final__done {
		margin: 0;
		font-family: 'Manrope Variable', var(--font-sans);
		font-size: clamp(1.25rem, 7.5cqi, 2.6rem);
		font-weight: 600;
		line-height: 1.1;
	}

	/* На телефоне окно узкое, команда целиком не влезет. Она есть в разделе установки */
	.final__brew {
		--ui-fg: #fff4e2;

		color: #fff4e2;

		@media (--below-sm) {
			display: none;
		}
	}
</style>
