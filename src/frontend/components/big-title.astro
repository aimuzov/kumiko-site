---
import '@fontsource-variable/unbounded'

type Props = {
	/** `id` заголовка, на него ссылается `aria-labelledby` раздела. */
	id: string
	/** SVG из lucide-static. */
	icon: string
	text: string
}

const { id, icon, text } = Astro.props
---

<!-- Заголовок раздела огромными буквами на слое под контентом. Он отстаёт от прокрутки,
     проявляется, пока раздел въезжает, и гаснет, когда тот уходит. Раздел даёт ему position и
     isolation, иначе слой уйдёт под фон страницы.

     Буквы нарочно едва отличаются от фона, поэтому они -- картинка для глаз, а для скринридера
     заголовок лежит рядом обычным h2, скрытым с экрана. e2e исключает картинку из проверки
     контраста: читать её не нужно.

     Значок раздела -- отдельный слой: огромный, в полэкрана, слева и едва виден. Он едет
     со своей скоростью и поворачивается, поэтому за буквами есть глубина -->
<div class="big-title">
	<h2 class="big-title__label" {id}>
		{text}
	</h2>
	<span class="big-title__glyph" aria-hidden="true" set:html={icon} />
	<span class="big-title__text" aria-hidden="true">
		<span class="big-title__float">{text}</span>
	</span>
</div>

<style>
	.big-title {
		pointer-events: none;
		position: absolute;
		z-index: -1;
		top: -6px;
		right: 0;
		left: 0;
		display: flex;
		justify-content: center;
	}

	.big-title__label {
		position: absolute;
		overflow: hidden;
		width: 1px;
		height: 1px;
		white-space: nowrap;
		clip-path: inset(50%);
	}

	/* Сплошная заливка цветом между акцентом и фоном: буквы видно, но они не спорят с контентом */
	.big-title__text {
		display: flex;
		gap: 0.15em;
		align-items: center;
		font-family: 'Unbounded Variable', var(--font-sans);
		font-size: var(--big-title);
		font-weight: 500;
		line-height: 0.9;
		color: color-mix(in srgb, var(--accent) 50%, var(--bg));
		letter-spacing: 0.01em;
		white-space: nowrap;
	}

	/* Сам по себе заголовок левитирует: прокрутку слушает внешний слой, а этот качается по
	   времени, поэтому они не спорят за transform */
	.big-title__float {
		display: flex;
		gap: 0.15em;
		align-items: center;

		@media (prefers-reduced-motion: no-preference) {
			animation: levitate 7s ease-in-out infinite;
		}
	}

	.big-title__glyph {
		position: absolute;
		top: -8vh;
		left: -6vw;
		width: 50vh;
		height: 50vh;
		/* Полупрозрачный акцент, а не смесь с фоном: фон под значком -- тёплый градиент, и
		   непрозрачная заливка ложилась на него серой заплаткой. Так значок чуть темнее того,
		   что под ним, и того же тона */
		color: light-dark(rgb(140 80 30 / 11%), rgb(220 150 90 / 9%));

		/* stylelint-disable-next-line selector-max-type -- SVG из lucide-static приходит без класса */
		& :global(svg) {
			width: 100%;
			height: 100%;
			stroke-width: 1.2;
		}
	}

	/* Свойства анимации по отдельности: минификатор склеивает сокращение `animation` с
	   `animation-timeline` в одно, а такое сокращение браузер отбрасывает целиком */
	@supports (animation-timeline: view()) {
		@media (prefers-reduced-motion: no-preference) {
			.big-title__text,
			.big-title__glyph {
				animation-timing-function: linear;
				animation-fill-mode: both;
				animation-timeline: view();
			}

			.big-title__text {
				animation-name: surface;
			}

			/* Значок медленнее букв и поворачивается, как будто лежит глубже */
			.big-title__glyph {
				animation-name: deep;
			}
		}
	}

	@keyframes levitate {
		0%,
		100% {
			transform: translateY(0) rotate(0deg);
		}

		33% {
			transform: translateY(-10px) rotate(-0.6deg);
		}

		66% {
			transform: translateY(6px) rotate(0.4deg);
		}
	}

	@keyframes deep {
		from {
			transform: translateY(40%) rotate(-10deg);
			opacity: 0;
		}

		30%,
		70% {
			opacity: 1;
		}

		to {
			transform: translateY(-20%) rotate(6deg);
			opacity: 0;
		}
	}

	@keyframes surface {
		from {
			transform: translateY(25%) scale(0.94);
			opacity: 0;
		}

		35%,
		60% {
			opacity: 1;
		}

		to {
			transform: translateY(-25%) scale(1.02);
			opacity: 0;
		}
	}
</style>
