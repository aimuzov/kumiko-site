---
type Props = {
	/** `id` заголовка, на него ссылается `aria-labelledby` раздела. */
	id: string
	/** SVG из lucide-static. */
	icon: string
	text: string
}

const { id, icon, text } = Astro.props
---

<!-- Заголовок раздела огромными буквами на слое под контентом. Он отстаёт от прокрутки,
     проявляется, пока раздел въезжает, и гаснет, когда тот уходит. Раздел даёт ему position и
     isolation, иначе слой уйдёт под фон страницы.

     Буквы нарочно едва отличаются от фона, поэтому они -- картинка для глаз, а для скринридера
     заголовок лежит рядом обычным h2, скрытым с экрана. e2e исключает картинку из проверки
     контраста: читать её не нужно -->
<div class="big-title">
	<h2 class="big-title__label" {id}>
		{text}
	</h2>
	<span class="big-title__text" aria-hidden="true">
		<span class="big-title__icon" set:html={icon} />
		{text}
	</span>
</div>

<style>
	.big-title {
		pointer-events: none;
		position: absolute;
		z-index: -1;
		top: 8px;
		right: 0;
		left: 0;
		display: flex;
		justify-content: center;
	}

	.big-title__label {
		position: absolute;
		overflow: hidden;
		width: 1px;
		height: 1px;
		white-space: nowrap;
		clip-path: inset(50%);
	}

	/* Сплошная заливка цветом между акцентом и фоном: буквы видно, но они не спорят с контентом */
	.big-title__text {
		display: flex;
		gap: 0.15em;
		align-items: center;
		font-size: var(--big-title);
		font-weight: 900;
		line-height: 0.9;
		color: color-mix(in srgb, var(--accent) 28%, var(--bg));
		letter-spacing: -0.05em;
		white-space: nowrap;
	}

	.big-title__icon {
		display: inline-grid;

		/* stylelint-disable-next-line selector-max-type -- SVG из lucide-static приходит без класса */
		& :global(svg) {
			width: 0.7em;
			height: 0.7em;
			stroke-width: 2.4;
		}
	}

	/* Свойства анимации по отдельности: минификатор склеивает сокращение `animation` с
	   `animation-timeline` в одно, а такое сокращение браузер отбрасывает целиком */
	@supports (animation-timeline: view()) {
		@media (prefers-reduced-motion: no-preference) {
			.big-title__text {
				animation-name: surface;
				animation-timing-function: linear;
				animation-fill-mode: both;
				animation-timeline: view();
			}
		}
	}

	@keyframes surface {
		from {
			transform: translateY(25%) scale(0.94);
			opacity: 0;
		}

		35%,
		60% {
			opacity: 1;
		}

		to {
			transform: translateY(-25%) scale(1.02);
			opacity: 0;
		}
	}
</style>
