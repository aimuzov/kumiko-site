---
import type { Locale } from '@aimuzov/infra-site-kit/i18n.js'
import { localizePath } from '@aimuzov/infra-site-kit/i18n.js'
import LangSwitch from '@aimuzov/infra-site-kit/ui/lang-switch.svelte'
import { Picture } from 'astro:assets'
import { Download } from 'lucide-static'

import icon from '#frontend/assets/icon.png'
import ThemeButton from '#frontend/components/theme-button.svelte'
import { t } from '#frontend/lib/i18n.ts'
import { newestRelease, REPO } from '#frontend/lib/kumiko.ts'

type Props = { locale: Locale }

const { locale } = Astro.props
const home = localizePath('/', locale)
const changelog = localizePath('/changelog/', locale)
const path = Astro.url.pathname.replace(/\/?$/, '/')
const newest = await newestRelease()

/** Разделы главной. С других страниц якорь ведёт на главную к нужному месту. */
const links = [
	{ href: `${path === home ? '' : home}#features`, label: t(locale, 'nav.features') },
	{ href: `${path === home ? '' : home}#steps`, label: t(locale, 'nav.steps') },
	{ href: `${path === home ? '' : home}#install`, label: t(locale, 'nav.install') },
	{ href: changelog, label: t(locale, 'changelog.link'), current: path === changelog },
]

// Значок GitHub из старого набора Lucide: в нынешнем знаков брендов нет
const github =
	'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65S8.93 17.38 9 18v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>'
---

<!-- Шапка прозрачная над первым экраном и становится стеклом, когда страница под ней поехала.
     Полоска снизу показывает, сколько страницы пройдено, а кнопка скачивания выезжает, когда
     большая кнопка первого экрана ушла за край -->
<header class="header" data-header>
	<div class="container header__inner">
		<a class="header__logo" href={home} aria-label={t(locale, 'header.home')}>
			<Picture class="header__icon" src={icon} alt="" width={28} height={28} formats={['avif', 'webp']} />
			<span class="header__name" aria-hidden="true">
				kumi<span class="header__accent">ko</span>
			</span>
		</a>

		<nav class="header__nav" aria-label={t(locale, 'nav.label')}>
			{links.map(({ href, label, current }) => (
				<a class="header__link" {href} aria-current={current ? 'page' : undefined}>
					{label}
				</a>
			))}
		</nav>

		<div class="header__tools">
			<LangSwitch {locale} path={Astro.url.pathname} client:load />
			<ThemeButton label={t(locale, 'theme.toggle')} client:load />
			<a
				class="header__tool"
				href={REPO}
				aria-label={t(locale, 'nav.source')}
				title={t(locale, 'nav.source')}
				set:html={github}
			/>
			<a class="header__download" href={newest.download}>
				<span set:html={Download} aria-hidden="true" />
				{t(locale, 'nav.download')}
			</a>
		</div>
	</div>
	<span class="header__progress" aria-hidden="true"></span>
</header>

<script>
	import { initHeader } from '#frontend/lib/header.ts'

	for (const header of document.querySelectorAll<HTMLElement>('[data-header]')) initHeader(header)
</script>

<style>
	.header {
		position: fixed;
		z-index: 30;
		top: 0;
		right: 0;
		left: 0;
		border-bottom: 1px solid transparent;
		transition:
			background-color 0.3s ease,
			border-color 0.3s ease,
			backdrop-filter 0.3s ease;

		&[data-scrolled] {
			border-bottom-color: color-mix(in srgb, var(--fg) 8%, transparent);
			background: color-mix(in srgb, var(--bg) 72%, transparent);
			backdrop-filter: saturate(1.4) blur(16px);
		}
	}

	.header__inner {
		display: flex;
		gap: 16px;
		align-items: center;
		height: var(--header-h);
	}

	.header__logo {
		display: inline-flex;
		flex: none;
		gap: 10px;
		align-items: center;
		font-size: 1.25rem;
		font-weight: 800;
		color: var(--fg);
		text-decoration: none;
		letter-spacing: -0.03em;
	}

	.header__icon {
		flex: none;
		width: 28px;
		height: 28px;
		transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);

		.header__logo:hover & {
			transform: rotate(-8deg) scale(1.08);
		}
	}

	.header__accent {
		color: var(--accent);
	}

	/* Якоря стоят по центру окна, а не между логотипом и кнопками: иначе выехавшая кнопка
	   скачивания сдвигала бы их вбок */
	.header__nav {
		position: absolute;
		left: 50%;
		transform: translateX(-50%);
		display: none;
		gap: 4px;

		@media (--lg) {
			display: flex;
		}
	}

	.header__link {
		padding: 6px 12px;
		border-radius: 999px;
		font-size: 0.9375rem;
		font-weight: 500;
		color: var(--muted);
		text-decoration: none;
		transition:
			color 0.2s ease,
			background-color 0.2s ease;

		&:hover,
		&[aria-current='page'] {
			color: var(--fg);
			background: color-mix(in srgb, var(--fg) 7%, transparent);
		}

		&:focus-visible {
			outline: 2px solid var(--accent);
			outline-offset: 2px;
		}
	}

	.header__tools {
		display: flex;
		gap: 4px;
		align-items: center;
		margin-left: auto;
	}

	.header__tool {
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		color: var(--fg);
		opacity: 0.6;
		transition: opacity 0.2s ease;

		/* На телефоне места мало, исходники подождут до подвала */
		@media (--below-sm) {
			display: none;
		}

		&:hover,
		&:focus-visible {
			opacity: 1;
		}

		&:focus-visible {
			outline: 2px solid var(--accent);
			outline-offset: 2px;
		}

		/* stylelint-disable-next-line selector-max-type -- SVG приходит строкой без класса */
		& :global(svg) {
			width: 20px;
			height: 20px;
		}
	}

	/* Пока видна большая кнопка первого экрана, маленькая спрятана: две кнопки "Скачать" рядом
	   ни к чему. Ушла большая -- маленькая выезжает справа */
	.header__download {
		overflow: hidden;
		display: inline-flex;
		gap: 6px;
		align-items: center;
		max-width: 0;
		margin-left: 0;
		padding: 7px 0;
		border-radius: 999px;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--on-accent);
		text-decoration: none;
		white-space: nowrap;
		opacity: 0;
		background: var(--accent);
		transition:
			max-width 0.4s cubic-bezier(0.22, 1, 0.36, 1),
			padding 0.4s cubic-bezier(0.22, 1, 0.36, 1),
			margin 0.4s cubic-bezier(0.22, 1, 0.36, 1),
			opacity 0.3s ease;

		[data-cta-gone] & {
			max-width: 160px;
			margin-left: 6px;
			padding-inline: 14px;
			opacity: 1;
		}

		/* stylelint-disable-next-line selector-max-type -- SVG из lucide-static приходит без класса */
		& :global(svg) {
			width: 16px;
			height: 16px;
		}
	}

	.header__progress {
		position: absolute;
		bottom: -1px;
		left: 0;
		transform-origin: left;
		transform: scaleX(0);
		width: 100%;
		height: 2px;
		background: linear-gradient(90deg, var(--accent), #ff9500);
	}

	/* Свойства анимации по отдельности: минификатор склеивает сокращение `animation` с
	   `animation-timeline` в одно, а такое сокращение браузер отбрасывает целиком */
	@supports (animation-timeline: scroll()) {
		@media (prefers-reduced-motion: no-preference) {
			.header__progress {
				animation-name: progress;
				animation-timing-function: linear;
				animation-fill-mode: both;
				animation-timeline: scroll(root);
			}
		}
	}

	@keyframes progress {
		to {
			transform: scaleX(1);
		}
	}
</style>
