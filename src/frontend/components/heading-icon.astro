---
type Props = {
	/** SVG из lucide-static. */
	icon: string
}

const { icon } = Astro.props
---

<!-- Значок над заголовком раздела в цветах иконки kumiko: тёмное дерево и сливочная фигура -->
<span class="heading-icon" aria-hidden="true" set:html={icon} />

<style>
	.heading-icon {
		display: grid;
		place-items: center;
		width: 60px;
		height: 60px;
		margin: 0 auto 18px;
		border-radius: 16px;
		color: #f3e2c3;
		background: linear-gradient(180deg, #8a5a36, #4f2f1b);
		box-shadow:
			0 10px 28px rgb(80 45 20 / 35%),
			inset 0 1px 0 rgb(255 255 255 / 18%);

		/* stylelint-disable-next-line selector-max-type -- SVG из lucide-static приходит без класса */
		& :global(svg) {
			width: 30px;
			height: 30px;
			stroke-width: 2;
		}
	}
</style>
