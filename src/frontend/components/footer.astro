---
import Credit from '@aimuzov/infra-site-kit/credit.astro'

import type { Locale } from '@aimuzov/infra-site-kit/i18n.js'

import { site } from '#frontend/data/site.ts'

type Props = { locale: Locale }

const { locale } = Astro.props
---

<footer class="footer">
	<div class="container">
		<Credit repo={site.repo} {locale} />
	</div>
</footer>

<style>
	.footer {
		/* Ссылки подписи из infra-site-kit при наведении подсвечиваются цветом текста. */
		--credit-hover: var(--fg);

		margin-top: auto;
		padding-block: 24px;
		font-size: 0.875rem;
		color: var(--muted);
	}
</style>
