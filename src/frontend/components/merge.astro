---
import type { Locale } from '@aimuzov/infra-site-kit/i18n.js'
import { Picture } from 'astro:assets'

import icon from '#frontend/assets/icon.png'
import PageIcon from '#frontend/components/page-icon.astro'
import { t } from '#frontend/lib/i18n.ts'

type Props = { locale: Locale }

const { locale } = Astro.props

/** Что обычно ставят по отдельности, место плашки на сцене, роль из словаря и та часть kumiko,
 *  что её заменяет: её значок стоит на плашке и потом в ряду под иконкой. */
const tools = [
	{ name: 'yabai', role: 'merge.windows', spot: 'a', page: 'workspaces' },
	{ name: 'skhd', role: 'merge.hotkeys', spot: 'b', page: 'hotkeys' },
	{ name: 'sketchybar', role: 'merge.bar', spot: 'c', page: 'bar' },
	{ name: 'JankyBorders', role: 'merge.borders', spot: 'd', page: 'borders' },
	{ name: 'Ice', role: 'merge.menubar', spot: 'e', page: 'menubar' },
	{ name: 'SketchyVim', role: 'merge.vim', spot: 'f', page: 'vim' },
] as const
---

<!-- Плашки утилит, которые обычно ставят по отдельности, при прокрутке слетаются в иконку
     kumiko. Без scroll-driven animations и при просьбе о меньшем движении стоят на местах -->
<section class="merge" aria-labelledby="merge-title">
	<div class="container">
		<h2 class="merge__title" id="merge-title">
			{t(locale, 'merge.title')}
		</h2>
		<p class="merge__lead">{t(locale, 'merge.lead')}</p>
		<div class="merge__stage">
			{tools.map(({ name, role, spot, page }) => (
				<span class={`merge__tool merge__tool--${spot}`}>
					<PageIcon {page} size="sm" />
					<span class="merge__label">
						<b class="merge__name">{name}</b>
						<span class="merge__role">{t(locale, role)}</span>
					</span>
				</span>
			))}
			<Picture class="merge__icon" src={icon} alt="kumiko" width={128} height={128} formats={['avif', 'webp']} />
			<span class="merge__inside" aria-hidden="true">
				{tools.map(({ page }) => (
					<PageIcon {page} size="xs" />
				))}
			</span>
		</div>
	</div>
</section>

<style>
	.merge {
		padding-block: var(--section-y);
		text-align: center;
	}

	.merge__title {
		margin: 0;
		font-size: clamp(1.8rem, 4vw, 2.6rem);
		letter-spacing: -0.02em;
	}

	.merge__lead {
		max-width: 40rem;
		margin: 12px auto 0;
		color: var(--muted);
		text-wrap: balance;
	}

	/* Сцена -- контейнер: путь плашки к центру задаётся в её долях, cqw и cqh */
	.merge__stage {
		position: relative;
		container-type: size;
		height: clamp(280px, 40vw, 360px);
		margin-top: 24px;
		view-timeline-name: --merge;
	}

	.merge__icon {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 112px;
		height: 112px;
		margin: -56px 0 0 -56px;
		filter: drop-shadow(0 16px 40px rgb(80 45 20 / 45%));
	}

	/* Плашка стоит на своём месте, а --to -- путь до центра, куда она улетит */
	.merge__tool {
		position: absolute;
		translate: -50% -50%;
		display: flex;
		gap: 10px;
		align-items: center;
		padding: 8px 14px 8px 8px;
		border: 1px solid color-mix(in srgb, var(--fg) 10%, transparent);
		border-radius: 14px;
		font-size: 0.875rem;
		text-align: left;
		background: color-mix(in srgb, var(--surface) 80%, transparent);
		backdrop-filter: blur(8px);
		box-shadow: 0 8px 24px rgb(0 0 0 / 15%);

		@media (--below-sm) {
			padding: 6px 10px;
			font-size: 0.75rem;
		}

		&--a {
			--to: 34cqw, 28cqh;

			top: 22%;
			left: 16%;
		}

		&--b {
			--to: 36cqw, -22cqh;

			top: 72%;
			left: 14%;
		}

		&--c {
			--to: 0, 44cqh;

			top: 6%;
			left: 50%;
		}

		&--d {
			--to: -34cqw, 26cqh;

			top: 24%;
			left: 84%;
		}

		&--e {
			--to: -36cqw, -24cqh;

			top: 74%;
			left: 86%;
		}

		&--f {
			--to: 0, -44cqh;

			top: 94%;
			left: 50%;
		}
	}

	.merge__label {
		display: flex;
		flex-direction: column;
	}

	/* Под иконкой -- значки всего, что теперь внутри. Проявляются, когда плашки долетели */
	.merge__inside {
		position: absolute;
		top: calc(50% + 84px);
		left: 50%;
		translate: -50% 0;
		display: flex;
		gap: 6px;
	}

	.merge__name {
		font-family: var(--font-mono);
	}

	.merge__role {
		font-size: 0.75rem;
		color: var(--muted);
	}

	/* Свойства анимации по отдельности: минификатор склеивает сокращение `animation` с
	   `animation-timeline` в одно, а такое сокращение браузер отбрасывает целиком */
	@supports (animation-timeline: view()) {
		@media (prefers-reduced-motion: no-preference) {
			/* Шкала общая, сцены: иначе нижние плашки трогались бы позже верхних. Пока сцена
			   въезжает и стоит на экране, плашки на местах, слетаются они в её верхней половине */
			.merge__tool,
			.merge__icon,
			.merge__inside {
				animation-timing-function: ease-in-out;
				animation-fill-mode: both;
				animation-timeline: --merge;
				animation-range: contain 35% contain 90%;
			}

			.merge__tool {
				animation-name: fly-in;
			}

			.merge__icon {
				animation-name: swallow;
			}

			.merge__inside {
				animation-name: reveal;
				animation-range: contain 80% contain 100%;
			}
		}
	}

	/* Плашка видна почти до самой иконки и гаснет уже на подлёте */
	@keyframes fly-in {
		70% {
			opacity: 1;
		}

		to {
			transform: translate(var(--to)) scale(0.3);
			opacity: 0;
		}
	}

	@keyframes reveal {
		from {
			transform: translateY(12px);
			opacity: 0;
		}
	}

	@keyframes swallow {
		from {
			transform: scale(0.7) rotate(-12deg);
		}

		85% {
			transform: scale(1.15) rotate(4deg);
		}

		to {
			transform: scale(1.3);
		}
	}
</style>
