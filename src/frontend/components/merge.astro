---
import type { Locale } from '@aimuzov/infra-site-kit/i18n.js'
import { Picture } from 'astro:assets'

import icon from '#frontend/assets/icon.png'
import PageIcon from '#frontend/components/page-icon.astro'
import { t } from '#frontend/lib/i18n.ts'

type Props = { locale: Locale }

const { locale } = Astro.props

/** Что обычно ставят по отдельности, место плашки на сцене, роль из словаря и та часть kumiko,
 *  что её заменяет: её значок стоит на плашке и потом в ряду под иконкой. */
const tools = [
	{ name: 'yabai', role: 'merge.windows', spot: 'a', page: 'workspaces' },
	{ name: 'skhd', role: 'merge.hotkeys', spot: 'b', page: 'hotkeys' },
	{ name: 'sketchybar', role: 'merge.bar', spot: 'c', page: 'bar' },
	{ name: 'JankyBorders', role: 'merge.borders', spot: 'd', page: 'borders' },
	{ name: 'Ice', role: 'merge.menubar', spot: 'e', page: 'menubar' },
	{ name: 'SketchyVim', role: 'merge.vim', spot: 'f', page: 'vim' },
] as const
---

<!-- Плашки утилит, которые обычно ставят по отдельности, при прокрутке слетаются в иконку
     kumiko на пружине из lib/merge.ts. Скрипт делает раздел высоким, а сцену липкой: всё стоит
     на экране, пока прокрутка ведёт поглощение. Без скрипта и при просьбе о меньшем движении
     раздел обычный, а плашки стоят на местах -->
<section class="merge" aria-labelledby="merge-title" data-merge-section>
	<div class="container merge__sticky">
		<!-- Строки размечены в словаре: <i> -- утилиты по порядку плашек, <b> -- итог, <em> и <s> --
		     одно и шесть в заголовке. Подсвечивает их lib/merge.ts по ходу поглощения -->
		<h2 class="merge__title" id="merge-title" set:html={t(locale, 'merge.title')} />
		<p class="merge__lead" set:html={t(locale, 'merge.lead')} />
		<div class="merge__stage" data-merge>
			{tools.map(({ name, role, spot, page }) => (
				<span class={`merge__tool merge__tool--${spot}`} data-tool>
					<PageIcon {page} size="sm" />
					<span class="merge__label">
						<b class="merge__name">{name}</b>
						<span class="merge__role">{t(locale, role)}</span>
					</span>
				</span>
			))}
			<span class="merge__core" data-core>
				<Picture
					class="merge__icon"
					src={icon}
					alt="kumiko"
					width={128}
					height={128}
					densities={[1, 2, 3]}
					formats={['avif', 'webp']}
				/>
			</span>
			<span class="merge__inside" aria-hidden="true">
				{tools.map(({ page }) => (
					<PageIcon {page} size="xs" />
				))}
			</span>
		</div>
	</div>
</section>

<script>
	import { initMerge } from '#frontend/lib/merge.ts'

	for (const stage of document.querySelectorAll<HTMLElement>('[data-merge]')) initMerge(stage)
</script>

<style>
	.merge {
		padding-block: var(--section-y);
		text-align: center;

		/* Прокрутки на поглощение -- экран сверх самого раздела */
		&--scrolly {
			height: 200vh;
			padding-block: 0;
		}
	}

	/* Сцена прилипает под шапкой и стоит, пока раздел проезжает. Заголовок уплывает вверх
	   параллаксом по --p, доле пройденного раздела */
	.merge--scrolly .merge__sticky {
		position: sticky;
		top: var(--header-h);
		display: flex;
		flex-direction: column;
		justify-content: center;
		height: calc(100vh - var(--header-h));
	}

	.merge--scrolly .merge__title,
	.merge--scrolly .merge__lead {
		transform: translateY(calc(var(--p, 0) * -40px));
	}

	.merge__title {
		margin: 0;
		font-size: clamp(1.8rem, 4vw, 2.6rem);
		letter-spacing: -0.02em;
	}

	.merge__lead {
		max-width: 40rem;
		margin: 12px auto 0;
		color: var(--muted);
		text-wrap: balance;
	}

	/* stylelint-disable selector-max-type -- <i>, <b>, <em> и <s> приходят разметкой из словаря */
	/* Утилита в тексте загорается плашкой цвета своего значка, когда её плашка влетела в иконку.
	   Цвета -- по порядку <i> в строке, тот же, что у плашек */
	.merge__lead :global(i) {
		margin: 0 -0.14em;
		padding: 0.04em 0.16em;
		border-radius: 0.35em;
		font-style: normal;
		background: color-mix(in srgb, var(--tint) 0%, transparent);
		transition:
			color 0.4s ease,
			background-color 0.4s ease;

		&:nth-of-type(1) {
			--tint: #32ade6;
		}

		&:nth-of-type(2) {
			--tint: #5856d6;
		}

		&:nth-of-type(3) {
			--tint: #ff9500;
		}

		&:nth-of-type(4) {
			--tint: #ff2d55;
		}

		&:nth-of-type(5) {
			--tint: #00c7be;
		}

		&:nth-of-type(6) {
			--tint: #34c759;
		}

		&.is-in {
			color: #fff;
			background: var(--tint);
		}
	}

	/* Итог подчёркивается медью, линия прорисовывается слева направо */
	.merge__lead :global(b) {
		font-weight: 600;
		color: var(--fg);
		background: linear-gradient(var(--accent), var(--accent)) 0 100% / 0% 2px no-repeat;
		transition: background-size 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.3s;
	}

	/* В заголовке "одно" загорается медью, а "шесть" гаснет и зачёркивается */
	.merge__title :global(em) {
		font-style: normal;
		transition: color 0.5s ease;
	}

	.merge__title :global(s) {
		text-decoration: none;
		background: linear-gradient(currentColor, currentColor) 0 55% / 0% 0.08em no-repeat;
		transition:
			color 0.5s ease,
			background-size 0.6s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.merge--done {
		& .merge__lead :global(b) {
			background-size: 100% 2px;
		}

		& .merge__title :global(em) {
			color: var(--accent);
		}

		& .merge__title :global(s) {
			color: var(--muted);
			background-size: 100% 0.08em;
		}
	}
	/* stylelint-enable selector-max-type */

	/* Сцена -- контейнер: путь плашки к центру задаётся в её долях, cqw и cqh */
	.merge__stage {
		position: relative;
		container-type: size;
		height: clamp(280px, 40vw, 360px);
		margin-top: 24px;
	}

	/* Иконка растёт с каждой проглоченной плашкой, --grow и --tilt ей задаёт lib/merge.ts */
	.merge__core {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: scale(var(--grow, 1)) rotate(calc(var(--tilt, 0) * 1deg));
		width: 112px;
		height: 112px;
		margin: -56px 0 0 -56px;

		/* Волна, когда проглочена последняя плашка */
		&::before,
		&::after {
			pointer-events: none;
			content: '';
			position: absolute;
			inset: 0;
			border: 2px solid var(--accent);
			border-radius: 28%;
			opacity: 0;
		}
	}

	.merge__icon {
		width: 100%;
		height: 100%;
		filter: drop-shadow(0 16px 40px rgb(80 45 20 / 45%));
		transition: filter 0.6s ease;
	}

	/* Плашка стоит на своём месте, --tx и --ty -- путь до центра, --k -- какая его доля пройдена,
	   --squash сплющивает её по скорости. Всё это двигает lib/merge.ts */
	.merge__tool {
		--k: 0;
		--squash: 0;
		--shrink: calc(1 - 0.65 * var(--k));

		position: absolute;

		/* Центрирование первым: после scale сдвиг на -50% уменьшался бы вместе с плашкой, и она
		   не долетала бы до центра. Отдельное свойство translate минификатор сливает в transform
		   как раз в конец, поэтому только так */
		transform: translate(-50%, -50%) translate(calc(var(--tx) * var(--k)), calc(var(--ty) * var(--k)))
			scale(calc(var(--shrink) * (1 + var(--squash))), calc(var(--shrink) * (1 - var(--squash))));
		display: flex;
		gap: 10px;
		align-items: center;
		padding: 8px 14px 8px 8px;
		border: 1px solid color-mix(in srgb, var(--fg) 10%, transparent);
		border-radius: 14px;
		font-size: 0.875rem;
		text-align: left;
		opacity: clamp(0, (1 - var(--k)) * 4, 1);
		background: color-mix(in srgb, var(--surface) 80%, transparent);
		backdrop-filter: blur(8px);
		box-shadow: 0 8px 24px rgb(0 0 0 / 15%);

		@media (--below-sm) {
			padding: 6px 10px;
			font-size: 0.75rem;
		}

		&--a {
			--tx: 34cqw;
			--ty: 28cqh;

			top: 22%;
			left: 16%;
		}

		&--b {
			--tx: 36cqw;
			--ty: -22cqh;

			top: 72%;
			left: 14%;
		}

		&--c {
			--tx: 0cqw;
			--ty: 44cqh;

			top: 6%;
			left: 50%;
		}

		&--d {
			--tx: -34cqw;
			--ty: 26cqh;

			top: 24%;
			left: 84%;
		}

		&--e {
			--tx: -36cqw;
			--ty: -24cqh;

			top: 74%;
			left: 86%;
		}

		&--f {
			--tx: 0cqw;
			--ty: -44cqh;

			top: 94%;
			left: 50%;
		}
	}

	.merge__label {
		display: flex;
		flex-direction: column;
	}

	/* Под иконкой -- значки всего, что теперь внутри. Проявляются, когда проглочена последняя
	   плашка */
	.merge__inside {
		position: absolute;
		top: calc(50% + 96px);
		right: 0;
		left: 0;
		transform: translateY(12px);
		display: flex;
		gap: 6px;
		justify-content: center;
		opacity: 0;
		transition:
			opacity 0.4s ease,
			transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.merge__name {
		font-family: var(--font-mono);
	}

	.merge__role {
		font-size: 0.75rem;
		color: var(--muted);
	}

	/* Все внутри: иконка светится акцентом, от неё расходятся две волны, под ней ряд значков */
	.merge--full {
		& .merge__icon {
			filter: drop-shadow(0 0 36px color-mix(in srgb, var(--accent) 70%, transparent))
				drop-shadow(0 16px 40px rgb(80 45 20 / 45%));
		}

		& .merge__core::before {
			animation: burst 0.9s ease-out;
		}

		& .merge__core::after {
			animation: burst 0.9s 0.15s ease-out;
		}

		& .merge__inside {
			transform: none;
			opacity: 1;
		}
	}

	@keyframes burst {
		from {
			transform: scale(1);
			opacity: 0.8;
		}

		to {
			transform: scale(2.6);
			opacity: 0;
		}
	}
</style>
