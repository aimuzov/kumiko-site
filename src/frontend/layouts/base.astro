---
import '@aimuzov/infra-site-kit/base.css'
import I18nHead from '@aimuzov/infra-site-kit/i18n-head.astro'
import LocaleBoot from '@aimuzov/infra-site-kit/locale-boot.astro'
import Sentry from '@aimuzov/infra-site-kit/sentry.astro'
import type { Locale } from '@aimuzov/infra-site-kit/i18n.js'
import ThemeBoot from '@aimuzov/infra-site-kit/theme-boot.astro'
import '@aimuzov/infra-site-kit/ui/tokens.css'

import Backdrop from '#frontend/components/backdrop.astro'
import Footer from '#frontend/components/footer.astro'
import Header from '#frontend/components/header.astro'
import '#frontend/styles/global.css'
import { site } from '#frontend/data/site.ts'
import { t } from '#frontend/lib/i18n.ts'
import { THEME_KEY } from '#frontend/lib/theme.ts'
import { pageTitle } from '#frontend/lib/title.ts'

type Props = {
	/** Язык страницы, по умолчанию русский. */
	locale?: Locale
	/** Название страницы, к нему добавится название сайта. У главной не задаётся. */
	title?: string
	/** `meta description` и `og:description`, по умолчанию описание сайта на языке страницы. */
	description?: string
	/** `false` у служебных страниц вроде 404: без canonical и с запретом индексации. */
	index?: boolean
}

const { locale = 'ru', title, index = true } = Astro.props
const description = Astro.props.description ?? t(locale, 'site.description')
const fullTitle = pageTitle(title)
const url = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<LocaleBoot />
		<ThemeBoot key={THEME_KEY} />
		<Sentry />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		{index ? <I18nHead /> : <meta name="robots" content="noindex" />}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:locale" content={locale === 'en' ? 'en_US' : 'ru_RU'} />
		<meta property="og:url" content={url} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<slot name="head" />
	</head>
	<body>
		<Backdrop />
		<Header {locale} />
		<slot />
		<Footer {locale} />
	</body>
</html>
