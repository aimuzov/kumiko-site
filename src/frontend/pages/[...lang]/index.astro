---
import type { Locale } from '@aimuzov/infra-site-kit/i18n.js'
import { Picture } from 'astro:assets'
import { Download, LayoutDashboard, PackageOpen, Sparkles } from 'lucide-static'

import icon from '#frontend/assets/icon.png'
import strip from '#frontend/assets/shots/strip.png'
import BrewCommand from '#frontend/components/brew-command.svelte'
import DesktopDemo from '#frontend/components/desktop-demo.astro'
import DodgyButton from '#frontend/components/dodgy-button.svelte'
import BigTitle from '#frontend/components/big-title.astro'
import HeadingIcon from '#frontend/components/heading-icon.astro'
import Merge from '#frontend/components/merge.astro'
import PageIcon from '#frontend/components/page-icon.astro'
import Steps from '#frontend/components/steps.astro'
import Ticker from '#frontend/components/ticker.astro'
import Base from '#frontend/layouts/base.astro'
import { langPaths, t } from '#frontend/lib/i18n.ts'
import { newestRelease, REPO } from '#frontend/lib/kumiko.ts'

export const getStaticPaths = langPaths

const { locale } = Astro.props as { locale: Locale }
const newest = await newestRelease()
const version = `v${newest.version}`

/** Возможности по порядку страниц окна настроек, текст -- в словаре по ключу. */
const features = ['workspaces', 'rules', 'hotkeys', 'bar', 'borders', 'vim'] as const
---

<Base {locale}>
	<main>
		<section class="hero">
			<div class="container hero__inner">
				<Picture class="hero__icon" src={icon} alt="" width={128} height={128} formats={['avif', 'webp']} />
				<h1 class="hero__title">
					kumi<span class="hero__title-accent">ko</span>
				</h1>
				<p class="hero__tagline">{t(locale, 'hero.tagline')}</p>
				<p class="hero__lead">{t(locale, 'hero.lead')}</p>
				<div class="hero__actions" data-cta>
					<a class="hero__download" href={newest.download}>
						<span set:html={Download} aria-hidden="true" />
						{t(locale, 'hero.download', { version })}
					</a>
					<BrewCommand {locale} client:visible />
				</div>
				<p class="hero__note">{t(locale, 'hero.requires')}</p>
			</div>

			<div class="container hero__stage">
				<DesktopDemo
					label={t(locale, 'hero.demo')}
					barLabel={t(locale, 'bar.strip')}
					hint={t(locale, 'hero.hint')}
				/>
			</div>
		</section>

		<Merge {locale} />

		<section class="features" id="features" aria-labelledby="features-title">
			<div class="container">
				<BigTitle id="features-title" icon={Sparkles} text={t(locale, 'features.title')} />
				<div class="features__grid">
					{features.map((key) => (
						<article class={`feature feature--${key}`}>
							<div class="feature__card" data-tilt>
								<div class="feature__visual" aria-hidden="true">
									{key === 'workspaces' && (
										<div class="mini-spaces">
											<span class="mini-spaces__glider" />
											<span class="mini-spaces__item">1</span>
											<span class="mini-spaces__item">2</span>
											<span class="mini-spaces__item">3</span>
											<span class="mini-spaces__item">4</span>
										</div>
									)}
									{key === 'rules' && (
										<div class="mini-rules">
											<span class="mini-rules__app">Finder</span>
											<span class="mini-rules__pick">Tile</span>
											<span class="mini-rules__app">Settings</span>
											<span class="mini-rules__pick mini-rules__pick--float">Float</span>
										</div>
									)}
									{key === 'hotkeys' && (
										<div class="mini-keys">
											<kbd class="mini-keys__key">⌥</kbd>
											<kbd class="mini-keys__key mini-keys__key--press">H</kbd>
											<kbd class="mini-keys__key">J</kbd>
											<kbd class="mini-keys__key">K</kbd>
											<kbd class="mini-keys__key">L</kbd>
										</div>
									)}
									{key === 'bar' && (
										<Picture
											class="mini-bar"
											src={strip}
											alt=""
											formats={['avif', 'webp']}
											widths={[505, 1010]}
											sizes="(width < 600px) 80vw, 340px"
										/>
									)}
									{key === 'borders' && (
										<div class="mini-frame">
											<span class="mini-frame__win" />
											<span class="mini-frame__win mini-frame__win--focus" />
										</div>
									)}
									{key === 'vim' && (
										<div class="mini-vim">
											<span class="mini-vim__line">
												dd<span class="mini-vim__cursor">w</span>
											</span>
											<span class="mini-vim__mode">-- NORMAL --</span>
										</div>
									)}
								</div>
								<PageIcon page={key} class="feature__icon" />
								<h3 class="feature__title">{t(locale, `${key}.title`)}</h3>
								<p class="feature__desc">{t(locale, `${key}.text`)}</p>
							</div>
						</article>
					))}
				</div>
			</div>
		</section>
		<Ticker />

		<Steps {locale} />

		<section class="install" id="install" aria-labelledby="install-title">
			<div class="container install__inner">
				<BigTitle id="install-title" icon={PackageOpen} text={t(locale, 'install.title')} />
				<p class="install__text">{t(locale, 'install.brew')}</p>
				<p class="install__text">
					<BrewCommand {locale} client:visible />
				</p>
				<p class="install__text">{t(locale, 'install.zip')}</p>
				<p class="install__text">
					<a class="install__zip" href={newest.download}>
						Kumiko-{newest.version}.zip
					</a>
					· <a href={`${REPO}/releases`}>GitHub Releases</a>
				</p>
				<p class="install__text install__text--muted">{t(locale, 'install.sip')}</p>
			</div>
		</section>

		<section class="final" aria-labelledby="final-title">
			<div class="container final__inner">
				<HeadingIcon icon={LayoutDashboard} />
				<h2 class="final__title" id="final-title">
					{t(locale, 'final.title')}
				</h2>
				<DodgyButton
					href={newest.download}
					label={t(locale, 'hero.download', { version })}
					dodges={t(locale, 'final.dodge').split('|')}
					client:visible
				/>
			</div>
		</section>
	</main>
</Base>

<script>
	import { initTilt } from '#frontend/lib/tilt.ts'

	for (const card of document.querySelectorAll<HTMLElement>('[data-tilt]')) initTilt(card)
</script>

<style>
	.hero {
		position: relative;
		padding-block: calc(var(--header-h) + var(--section-y)) var(--section-y);
		text-align: center;

		/* Тёплое свечение за иконкой, как на баннере README */
		&::before {
			content: '';
			position: absolute;
			z-index: -1;
			top: 0;
			left: 50%;
			transform: translateX(-50%);
			width: min(900px, 120vw);
			height: 560px;
			background: radial-gradient(closest-side, var(--glow), transparent);
		}
	}

	.hero__inner {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.hero__icon {
		width: 112px;
		height: 112px;
		filter: drop-shadow(0 12px 32px rgb(80 45 20 / 35%));
	}

	.hero__title {
		margin: 12px 0 0;
		font-size: clamp(4rem, 14vw, 8.5rem);
		font-weight: 800;
		line-height: 1;
		letter-spacing: -0.04em;
	}

	.hero__title-accent {
		color: var(--accent);
	}

	.hero__tagline {
		margin: 18px 0 0;
		font-size: clamp(0.8rem, 2vw, 1rem);
		font-weight: 700;
		color: var(--muted);
		text-transform: uppercase;
		letter-spacing: 0.32em;
	}

	.hero__lead {
		max-width: 38rem;
		margin: 20px 0 0;
		font-size: clamp(1.05rem, 2.2vw, 1.25rem);
		text-wrap: balance;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px 16px;
		align-items: center;
		justify-content: center;
		margin-top: 28px;
	}

	.hero__download {
		display: inline-flex;
		gap: 8px;
		align-items: center;
		padding: 12px 22px;
		border-radius: 999px;
		font-weight: 600;
		color: var(--on-accent);
		text-decoration: none;
		background: var(--accent);
		transition: filter 0.2s ease;

		&:hover {
			filter: brightness(1.08);
		}

		&:focus-visible {
			outline: 2px solid var(--accent);
			outline-offset: 3px;
		}

		/* stylelint-disable-next-line selector-max-type -- SVG из lucide-static приходит без класса */
		& :global(svg) {
			width: 18px;
			height: 18px;
		}
	}

	.hero__note {
		margin: 12px 0 0;
		font-size: 0.875rem;
		color: var(--muted);
	}

	.hero__stage {
		display: flex;
		justify-content: center;
		margin-top: clamp(40px, 6vw, 72px);
	}

	/* Над контентом раздела на фоновом слое стоит огромный заголовок из big-title.astro: раздел
	   держит этот слой, обрезает его по ширине и оставляет сверху место под буквы */
	.features,
	.install {
		isolation: isolate;
		position: relative;
		overflow-x: clip;
		padding-block: var(--section-top) var(--section-y);
	}

	.features__grid {
		display: grid;
		gap: 20px;

		@media (--sm) {
			grid-template-columns: repeat(2, 1fr);
		}

		@media (--lg) {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	/* Карточка: сверху маленькая живая картинка возможности, под ней значок страницы настроек */
	/* Карточку двигает прокрутка, а наклон за курсором -- у слоя внутри, чтобы они не спорили
	   за transform. Пятно света идёт за курсором цветом значка страницы */
	.feature {
		--tint: #32ade6;

		&--rules {
			--tint: #af52de;
		}

		&--hotkeys {
			--tint: #5856d6;
		}

		&--bar {
			--tint: #ff9500;
		}

		&--borders {
			--tint: #ff2d55;
		}

		&--vim {
			--tint: #34c759;
		}
	}

	.feature__card {
		position: relative;
		transform: perspective(900px) rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
		overflow: hidden;
		height: 100%;
		padding: 24px;
		border: 1px solid color-mix(in srgb, var(--fg) 8%, transparent);
		border-radius: 20px;
		background: color-mix(in srgb, var(--surface) 70%, transparent);
		backdrop-filter: blur(12px);
		transition:
			transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
			border-color 0.3s ease;

		&::before {
			pointer-events: none;
			content: '';
			position: absolute;
			inset: 0;
			opacity: 0;
			background: radial-gradient(
				320px circle at var(--spot-x, 50%) var(--spot-y, 0%),
				color-mix(in srgb, var(--tint) 22%, transparent),
				transparent 70%
			);
			transition: opacity 0.3s ease;
		}

		&:hover {
			border-color: color-mix(in srgb, var(--tint) 45%, transparent);

			&::before {
				opacity: 1;
			}
		}
	}

	.feature__visual {
		display: grid;
		place-items: center;
		height: 120px;
		margin: -8px -8px 20px;
		border-radius: 14px;
		background: #14161c;
	}

	.feature__icon {
		margin-bottom: 14px;
	}

	.feature__title {
		margin: 0;
		font-size: 1.25rem;
		letter-spacing: -0.01em;
	}

	.feature__desc {
		margin: 8px 0 0;
		color: var(--muted);
	}

	.mini-spaces {
		position: relative;
		display: flex;
		gap: 8px;
		padding: 6px;
		border-radius: 12px;
		background: #0a111e;
	}

	.mini-spaces__item {
		display: grid;
		place-items: center;
		width: 34px;
		height: 30px;
		border-radius: 8px;
		font-weight: 600;
		color: #cfd6e4;
	}

	/* Подложка выбранного стола переезжает со второго на третий и обратно */
	.mini-spaces__glider {
		position: absolute;
		top: 6px;
		left: calc(6px + 42px);
		width: 34px;
		height: 30px;
		border-radius: 8px;
		background: #2b3a55;
		animation: space-pick 4s ease-in-out infinite;
	}

	.mini-spaces__item {
		position: relative;
	}

	.mini-rules {
		display: grid;
		grid-template-columns: auto auto;
		gap: 8px 16px;
		align-items: center;
		font-size: 0.875rem;
		color: #e6e6ea;
	}

	.mini-rules__pick {
		padding: 2px 10px;
		border-radius: 6px;
		color: #fff;
		background: #1f63e0;

		&--float {
			background: #8e3fbd;
		}
	}

	.mini-keys {
		display: flex;
		gap: 6px;
	}

	.mini-keys__key {
		display: grid;
		place-items: center;
		min-width: 34px;
		height: 34px;
		padding: 0 8px;
		border-radius: 8px;
		font-family: var(--font-sans);
		font-weight: 600;
		color: #e6e6ea;
		background: #2a2b31;
		box-shadow: 0 3px 0 #0c0d10;

		&--press {
			animation: key-press 2.4s ease-in-out infinite;
		}
	}

	.mini-bar {
		width: 90%;
		height: auto;
		border-radius: 8px;
	}

	.mini-frame {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 6px;
		width: 60%;
		height: 70%;
	}

	.mini-frame__win {
		border-radius: 6px;
		background: #2a2b31;

		&--focus {
			box-shadow: 0 0 0 2px #8aadf4;
			animation: frame-glow 3s ease-in-out infinite;
		}
	}

	.mini-vim {
		display: flex;
		flex-direction: column;
		gap: 10px;
		align-items: center;
		font-family: var(--font-mono);
		color: #e6e6ea;
	}

	.mini-vim__cursor {
		color: #14161c;
		background: #5af78e;
		animation: blink 1.2s steps(1) infinite;
	}

	.mini-vim__mode {
		font-size: 0.75rem;
		color: #5af78e;
	}

	.install__inner {
		max-width: calc(760px + var(--gutter) * 2);
	}

	.install__text {
		margin: 0 0 14px;

		&--muted {
			font-size: 0.9375rem;
			color: var(--muted);
		}
	}

	.install__zip {
		font-family: var(--font-mono);
	}

	.final {
		padding-block: var(--section-y) calc(var(--section-y) * 1.5);
	}

	.final__inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	.final__title {
		margin: 0 0 28px;
		font-size: clamp(2.2rem, 6vw, 4rem);
		font-weight: 800;
		letter-spacing: -0.03em;
	}

	/* Иконка покачивается и мелочи в карточках шевелятся по времени, остальное едет за прокруткой.
	   Без scroll-driven animations остаётся только первое, а просьба системы уменьшить движение
	   останавливает всё */
	@media (--reduced-motion) {
		.mini-spaces__glider,
		.mini-keys__key--press,
		.mini-frame__win--focus,
		.mini-vim__cursor {
			animation: none;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero__icon {
			animation: float 6s ease-in-out infinite;
		}

		/* Свойства анимации по отдельности: минификатор склеивает сокращение `animation` с
		   `animation-timeline` в одно, а такое сокращение браузер отбрасывает целиком */
		@supports (animation-timeline: view()) {
			/* Первый экран при уходе вверх отстаёт от прокрутки и гаснет */
			.hero__inner {
				animation-name: sink;
				animation-timing-function: linear;
				animation-fill-mode: both;
				animation-timeline: view();
				animation-range: exit 0% exit 100%;
			}

			/* Рабочий стол встаёт из наклона, как на страницах продуктов */
			.hero__stage {
				transform-origin: 50% 100%;
				animation-name: rise;
				animation-timing-function: linear;
				animation-fill-mode: both;
				animation-timeline: view();
				animation-range: entry 0% cover 40%;
			}

			/* Карточки проявляются и всплывают, каждая колонка со своей скоростью */
			.feature {
				animation-name: appear, parallax;
				animation-timing-function: linear;
				animation-fill-mode: both;
				animation-timeline: view(), view();
				animation-range:
					entry 0% entry 80%,
					cover 0% cover 100%;

				&:nth-child(3n + 2) {
					--lift: 60px;
				}
			}
		}
	}

	@keyframes float {
		50% {
			transform: translateY(-8px) rotate(-2deg);
		}
	}

	@keyframes sink {
		to {
			transform: translateY(35%) scale(0.96);
			opacity: 0;
		}
	}

	@keyframes rise {
		from {
			transform: perspective(1600px) rotateX(24deg) scale(0.9);
		}
	}

	@keyframes appear {
		from {
			opacity: 0;
		}
	}

	@keyframes parallax {
		from {
			transform: translateY(var(--lift, 30px));
		}

		to {
			transform: translateY(calc(var(--lift, 30px) * -1));
		}
	}

	@keyframes space-pick {
		0%,
		45% {
			transform: none;
		}

		50%,
		95% {
			transform: translateX(42px);
		}
	}

	@keyframes key-press {
		0%,
		40%,
		60%,
		100% {
			transform: none;
			box-shadow: 0 3px 0 #0c0d10;
		}

		50% {
			transform: translateY(3px);
			background: #3478f6;
			box-shadow: 0 0 0 #0c0d10;
		}
	}

	@keyframes frame-glow {
		50% {
			box-shadow:
				0 0 0 2px #8aadf4,
				0 0 18px #8aadf480;
		}
	}

	@keyframes blink {
		50% {
			color: inherit;
			background: transparent;
		}
	}
</style>
